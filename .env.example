# Copy to .env and fill in. Never commit .env.

# --- Language models -------------------------------------------------------------------------------------------
# openai | azure | bedrock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-nano
# Embeddings use OpenAI or Azure OpenAI (default: the same as LLM_PROVIDER, or openai when that is bedrock).
# Must be the same model that built the Milvus collection.
EMBEDDING_MODEL=text-embedding-3-large
#EMBEDDING_PROVIDER=openai

# OpenAI (or an OpenAI-compatible server: also set OPENAI_BASE_URL)
OPENAI_API_KEY=
#OPENAI_BASE_URL=

# Azure OpenAI (LLM_MODEL and EMBEDDING_MODEL are deployment names)
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
#AZURE_OPENAI_API_VERSION=2024-10-21

# AWS Bedrock: uses the standard AWS credential chain (env vars, profile or IAM role). LLM_MODEL is a Bedrock model
# or inference-profile id.
#AWS_REGION=us-east-1

# --- Milvus ----------------------------------------------------------------------------------------------------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
MILVUS_SECURE=false
MILVUS_COLLECTION=fda_guidance_embeddings

# --- Optional --------------------------------------------------------------------------------------------------
USE_RERANKING=false
#RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
#RERANK_CANDIDATES=60
# Set to 1 once the reranker model is cached, so startup does not contact the Hugging Face Hub
#HF_HUB_OFFLINE=1

#PLANNER_ALWAYS=true
#MAX_SUBQUERIES=3
#MULTI_QUERY_TOP_K=12
#MIN_RELEVANCE=0.35
